{
  "name": "obsidian-vivlio",
  "version": "0.4.0",
  "description": "Typeset your Obsidian notes with Vivliostyle (CSS paged media) and export to PDF / EPUB.",
  "main": "main.js",
  "license": "AGPL-3.0-or-later",
  "author": "nonkuri",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/run.mjs test/convert.test.ts && node test/run.mjs test/config.test.ts && node test/run.mjs test/server.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@vivliostyle/core": "^2.45.0",
    "@vivliostyle/theme-academic": "^2.0.2",
    "@vivliostyle/theme-base": "^2.1.1",
    "@vivliostyle/theme-bunko": "^2.0.2",
    "@vivliostyle/theme-techbook": "^2.0.2",
    "@vivliostyle/vfm": "^2.7.2",
    "@vivliostyle/viewer": "^2.45.0",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "valibot": "^1.4.2"
  },
  "overrides": {
    "prismjs": "^1.30.0",
    "trim": "0.0.3",
    "valibot": "$valibot"
  }
}
